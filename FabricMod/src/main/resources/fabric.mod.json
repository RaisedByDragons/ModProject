{
	"schemaVersion": 1,
	"id": "mod",
	"version": "${version}",
	"name": "Mod",
	"description": "Adds a new dimension to Minecraft as well as a multitude of items and mobs",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/Emmett93/TSP-Minecraft-Mod.git"
	},
	"license": "CC0-1.0",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mod.Mod"
		],
		"client": [
			"com.mod.ModClientInit"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}